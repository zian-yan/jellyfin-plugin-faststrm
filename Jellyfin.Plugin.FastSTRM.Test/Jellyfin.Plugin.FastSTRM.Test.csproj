<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Jellyfin.Plugin.FastSTRM.Test</AssemblyName>
    <RootNamespace>FastSTRM.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    插件项目对 Jellyfin 包使用了 ExcludeAssets="runtime"，宿主会提供这些程序集；
    但测试进程没有宿主，实例化 BaseItem（Video）时必须能加载 MediaBrowser.Controller，
    所以测试项目自己引用一份，且保留 runtime 资产。
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.FastSTRM\Jellyfin.Plugin.FastSTRM.csproj" />
  </ItemGroup>

</Project>
